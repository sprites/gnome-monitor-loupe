<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.monitor-loupe" path="/org/gnome/shell/extensions/monitor-loupe/">
    <key name="frame-color" type="s">
      <default>'#242b33'</default>
      <summary>Frame and handle color in #rrggbb format</summary>
    </key>
    <key name="rectangle-border-width" type="i">
      <default>2</default>
      <range min="0" max="20"/>
      <summary>Lens frame thickness in logical pixels</summary>
    </key>
    <key name="lens-shape" type="s">
      <default>'rectangle'</default>
      <choices>
        <choice value="rectangle"/>
        <choice value="loupe"/>
        <choice value="binoculars"/>
        <choice value="telescope"/>
      </choices>
      <summary>Magnifier appearance</summary>
    </key>
    <key name="lens-radius" type="i">
      <default>300</default>
      <range min="60" max="2160"/>
      <summary>Round lens radius in logical pixels</summary>
    </key>
    <key name="lens-width" type="i">
      <default>1000</default>
      <range min="160" max="7680"/>
      <summary>Lens width in logical pixels</summary>
    </key>
    <key name="lens-height" type="i">
      <default>650</default>
      <range min="90" max="4320"/>
      <summary>Lens height in logical pixels</summary>
    </key>
    <key name="scroll-zoom" type="b">
      <default>true</default>
      <summary>Zoom with Super+Alt and the scroll wheel</summary>
    </key>
    <key name="zoom-step" type="d">
      <default>0.25</default>
      <range min="0.05" max="5.0"/>
      <summary>Magnification added or removed per zoom step</summary>
    </key>
    <key name="loupe-zoom-in" type="as">
      <default>[]</default>
      <summary>Shortcut to zoom in using the configured step</summary>
    </key>
    <key name="loupe-zoom-out" type="as">
      <default>[]</default>
      <summary>Shortcut to zoom out using the configured step</summary>
    </key>
  </schema>
</schemalist>
